# VerdictOps Environment Configuration
# Optional SQLite database path override (auto-defaults to ./data/verdictops.db locally or /tmp/verdictops.db on Vercel)
VERDICT_DB_PATH=./data/verdictops.db

# Optional BYOK LLM-as-a-Judge configuration (alternatively supplied via UI header X-LLM-Api-Key)
LLM_JUDGE_BASE_URL=https://api.openai.com/v1
LLM_JUDGE_MODEL=gpt-4o-mini
